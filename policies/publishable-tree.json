{
  "policy_version": 1,
  "max_blob_bytes": 1048576,
  "forbidden_paths": [
    {"kind": "prefix", "value": "data/raw/", "category": "raw_source_data"},
    {"kind": "prefix", "value": "data/registry-archive/", "category": "raw_source_data"},
    {"kind": "prefix", "value": "data/generated-diffs/", "category": "generated_diff_output"},
    {"kind": "exact", "value": "data/mitos.db", "category": "private_database"},
    {"kind": "suffix", "value": ".duckdb", "category": "database_file"},
    {"kind": "suffix", "value": ".db", "category": "database_file"},
    {"kind": "suffix", "value": ".pdf", "category": "source_pdf"}
  ]
}
