{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Closed Gate E ten-condition evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recorded_at",
    "conditions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "portfolio-ready-v1"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
    },
    "conditions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "text",
          "status",
          "evidence",
          "amendment"
        ],
        "properties": {
          "condition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "[^\\r\\n]+"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "pass_with_disclosed_deviation"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "locator",
                    "claim",
                    "recorded_at",
                    "conclusion",
                    "head_sha",
                    "evidence_class",
                    "event"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "ci_run"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    },
                    "claim": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    },
                    "recorded_at": {
                      "type": "string",
                      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
                    },
                    "conclusion": {
                      "type": "string",
                      "enum": [
                        "success",
                        "failure",
                        "cancelled",
                        "skipped"
                      ]
                    },
                    "head_sha": {
                      "type": "string",
                      "pattern": "[0-9a-f]{40}"
                    },
                    "evidence_class": {
                      "type": "string",
                      "enum": [
                        "fixture_hosted_replay",
                        "live_source_observation",
                        "actual_schedule_observation",
                        "real_restore_republish_observation"
                      ]
                    },
                    "event": {
                      "type": "string",
                      "enum": [
                        "workflow_dispatch",
                        "schedule",
                        "push"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "locator",
                    "claim"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "commit"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    },
                    "claim": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "locator",
                    "claim"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "test_id"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    },
                    "claim": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "locator",
                    "claim",
                    "sha256"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "file_sha256"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    },
                    "claim": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "[0-9a-f]{64}"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "locator",
                    "claim",
                    "sha256"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "manifest"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    },
                    "claim": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "[0-9a-f]{64}"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "locator",
                    "claim",
                    "recorded_at",
                    "conclusion"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "service_observation"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    },
                    "claim": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    },
                    "recorded_at": {
                      "type": "string",
                      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
                    },
                    "conclusion": {
                      "type": "string",
                      "enum": [
                        "observed"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "locator",
                    "claim",
                    "recorded_at",
                    "conclusion"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "owner_attestation"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    },
                    "claim": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "[^\\r\\n]+"
                    },
                    "recorded_at": {
                      "type": "string",
                      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
                    },
                    "conclusion": {
                      "type": "string",
                      "enum": [
                        "observed"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "amendment": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "locator",
                  "sha256",
                  "recorded_at"
                ],
                "properties": {
                  "locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "[^\\r\\n]+"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "[0-9a-f]{64}"
                  },
                  "recorded_at": {
                    "type": "string",
                    "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
