{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calico.internal/contracts/publication-exports-v3.schema.json",
  "title": "Calico publication export and control authority (v3)",
  "description": "Supersedes publication-exports-v2; adds the four-page release banner and lookup observation warning. CSV exports and JSON control sources have independent closed grammars.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "allowlist_version",
    "exports",
    "supersedes",
    "control_sources",
    "addition_reasons"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "The closed document schema version."
    },
    "allowlist_version": {
      "const": "publication-exports-v3",
      "description": "The stable publication authority identifier."
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/export_entry"
      },
      "description": "Every approved export, sorted by export name."
    },
    "supersedes": {
      "const": "publication-exports-v2"
    },
    "control_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "export_name",
          "export_class",
          "fixed_path",
          "format",
          "source_contract",
          "columns"
        ],
        "properties": {
          "export_name": {
            "const": "capture_status"
          },
          "export_class": {
            "const": "control"
          },
          "fixed_path": {
            "const": "capture-status.json"
          },
          "format": {
            "const": "json"
          },
          "source_contract": {
            "const": "capture-status-v3"
          },
          "columns": {
            "const": [
              "outcome",
              "reason_category",
              "ended_at_utc",
              "newer_attempt_not_accepted",
              "source_publication_state",
              "source_publication_retired_on"
            ]
          }
        }
      }
    },
    "addition_reasons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mart_publication_status.published_as_of_date",
        "mart_publication_status.published_release_revision",
        "dim_public_organizations.latest_release_observation_state",
        "capture_status.outcome",
        "capture_status.reason_category",
        "capture_status.ended_at_utc",
        "capture_status.newer_attempt_not_accepted",
        "capture_status.source_publication_state",
        "capture_status.source_publication_retired_on"
      ],
      "properties": {
        "mart_publication_status.published_as_of_date": {
          "type": "string",
          "minLength": 1
        },
        "mart_publication_status.published_release_revision": {
          "type": "string",
          "minLength": 1
        },
        "dim_public_organizations.latest_release_observation_state": {
          "type": "string",
          "minLength": 1
        },
        "capture_status.outcome": {
          "type": "string",
          "minLength": 1
        },
        "capture_status.reason_category": {
          "type": "string",
          "minLength": 1
        },
        "capture_status.ended_at_utc": {
          "type": "string",
          "minLength": 1
        },
        "capture_status.newer_attempt_not_accepted": {
          "type": "string",
          "minLength": 1
        },
        "capture_status.source_publication_state": {
          "type": "string",
          "minLength": 1
        },
        "capture_status.source_publication_retired_on": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "export_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "export_name",
        "export_class",
        "source_relation",
        "columns",
        "grain",
        "measures",
        "file_name",
        "dialect"
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "export_name": {
                  "const": "dim_public_organizations"
                },
                "file_name": {
                  "const": "dim_public_organizations.csv"
                }
              }
            },
            {
              "properties": {
                "export_name": {
                  "const": "fct_public_status_observations"
                },
                "file_name": {
                  "const": "fct_public_status_observations.csv"
                }
              }
            },
            {
              "properties": {
                "export_name": {
                  "const": "mart_adjacent_pair_metrics"
                },
                "file_name": {
                  "const": "mart_adjacent_pair_metrics.csv"
                }
              }
            },
            {
              "properties": {
                "export_name": {
                  "const": "mart_claim_support"
                },
                "file_name": {
                  "const": "mart_claim_support.csv"
                }
              }
            },
            {
              "properties": {
                "export_name": {
                  "const": "mart_last_renewal_diagnostic"
                },
                "file_name": {
                  "const": "mart_last_renewal_diagnostic.csv"
                }
              }
            },
            {
              "properties": {
                "export_name": {
                  "const": "mart_registry_population_coverage"
                },
                "file_name": {
                  "const": "mart_registry_population_coverage.csv"
                }
              }
            },
            {
              "properties": {
                "export_name": {
                  "const": "mart_release_quality"
                },
                "file_name": {
                  "const": "mart_release_quality.csv"
                }
              }
            },
            {
              "properties": {
                "export_name": {
                  "const": "mart_release_snapshot_metrics"
                },
                "file_name": {
                  "const": "mart_release_snapshot_metrics.csv"
                }
              }
            },
            {
              "properties": {
                "export_name": {
                  "const": "mart_source_reported_status_age"
                },
                "file_name": {
                  "const": "mart_source_reported_status_age.csv"
                }
              }
            },
            {
              "properties": {
                "export_name": {
                  "const": "mart_spell_censoring_summary"
                },
                "file_name": {
                  "const": "mart_spell_censoring_summary.csv"
                }
              }
            },
            {
              "properties": {
                "export_name": {
                  "const": "mart_starting_cohort_persistence"
                },
                "file_name": {
                  "const": "mart_starting_cohort_persistence.csv"
                }
              }
            },
            {
              "properties": {
                "export_name": {
                  "const": "mart_publication_status"
                },
                "file_name": {
                  "const": "mart_publication_status.csv"
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "export_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "The stable public export name."
        },
        "export_class": {
          "enum": [
            "aggregate",
            "named_history"
          ],
          "description": "The closed class selecting the applicable boundary rules."
        },
        "source_relation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "The one existing dbt relation serialized by this export."
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "The exact ordered positive public column projection; order is significant."
        },
        "grain": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "The exact key columns whose uniqueness the gate proves."
        },
        "measures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "Aggregate measure columns; empty for named history."
        },
        "file_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.csv$",
          "description": "Must equal export_name plus .csv; the production name/file pairs are closed above."
        },
        "dialect": {
          "const": "calico-csv-v1",
          "description": "The one deterministic UTF-8 CSV dialect."
        }
      }
    }
  }
}
