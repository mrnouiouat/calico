{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calico.internal/contracts/d1-d8-dispositions-v1.schema.json",
  "title": "Calico D1-D8 defect disposition matrix (v1)",
  "description": "Closed, versioned, machine-checkable D1-D8 project memory (D-12). Exactly eight ordered entries, one per known defect. Each entry names the defect, its v1 disposition, Phase 3 evidence status, owning phase/tier, current evidence (paths and, where applicable, discoverable test identifiers), a concise note, and a closed ordered list of any still-pending downstream obligation owned by a later phase. This document never carries a canonical object hash, private path, raw row, or excluded value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "defects"],
  "properties": {
    "contract_version": { "const": 1 },
    "defects": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": false,
      "prefixItems": [
        { "$ref": "#/$defs/defect", "properties": { "id": { "const": "D1" } } },
        { "$ref": "#/$defs/defect", "properties": { "id": { "const": "D2" } } },
        { "$ref": "#/$defs/defect", "properties": { "id": { "const": "D3" } } },
        { "$ref": "#/$defs/defect", "properties": { "id": { "const": "D4" } } },
        { "$ref": "#/$defs/defect", "properties": { "id": { "const": "D5" } } },
        { "$ref": "#/$defs/defect", "properties": { "id": { "const": "D6" } } },
        { "$ref": "#/$defs/defect", "properties": { "id": { "const": "D7" } } },
        { "$ref": "#/$defs/defect", "properties": { "id": { "const": "D8" } } }
      ]
    }
  },
  "$defs": {
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "v1_disposition",
        "phase_3_evidence_status",
        "owner",
        "evidence",
        "note",
        "downstream_obligations"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^D[1-8]$" },
        "name": { "type": "string", "minLength": 1 },
        "v1_disposition": { "type": "string", "minLength": 1 },
        "phase_3_evidence_status": {
          "enum": ["implemented_and_tested", "explicit_exclusion", "linked_to_phase_2"]
        },
        "owner": { "$ref": "#/$defs/owner" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_entry" }
        },
        "note": { "type": "string", "minLength": 1 },
        "downstream_obligations": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/$defs/downstream_obligation" }
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "tier"],
      "properties": {
        "phase": { "type": "string", "pattern": "^Phase [2-8]$" },
        "tier": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "identifier"],
      "properties": {
        "type": {
          "enum": [
            "python_test",
            "dbt_singular_test",
            "dbt_schema_test",
            "contract",
            "document"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "identifier": { "type": ["string", "null"] }
      }
    },
    "downstream_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owning_phase", "requirement", "status"],
      "properties": {
        "owning_phase": { "enum": ["Phase 4", "Phase 5", "Phase 8"] },
        "requirement": { "type": "string", "minLength": 1 },
        "status": { "const": "pending" }
      }
    }
  }
}
