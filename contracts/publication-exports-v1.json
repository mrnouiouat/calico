        "source_list",
        "source_reported_registry_status",
        "coverage_class",
        "record_count"
      ],
      "grain": [
        "as_of_date",
        "release_revision",
        "revision_fingerprint",
        "source_list",
        "source_reported_registry_status",
        "coverage_class"
      ],
