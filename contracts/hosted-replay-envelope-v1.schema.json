              }
            }
          },
          "description": "Complete observed protected branch/tag inventory including refs/heads/main and refs/heads/published-data, sorted uniquely by ref. SHA identifies the observed Git ref target, not manifest bytes."
        },
        "published_manifest_sha256": {
