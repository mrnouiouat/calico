    "evidence_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosted_fixture_replay",
        "live_source",
        "actual_schedule",
        "historical_real_restore_republish"
      ],
      "properties": {
        "hosted_fixture_replay": {
          "const": "measured"
        },
        "live_source": {
          "const": "not_observed_by_replay"
        },
        "actual_schedule": {
          "const": "not_observed_by_replay"
        },
        "historical_real_restore_republish": {
          "const": "preserved"
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_name",
          "job_id",
          "status",
          "conclusion"
        ],
        "properties": {
          "job_name": {
            "enum": [
              "prepare-accepted",
              "prepare-repeat",
              "prepare-rejected",
              "route-accepted",
              "route-repeat",
              "route-rejected",
              "route-calendar-refused",
              "route-failure",
              "route-cancelled",
              "publish-accepted",
              "publish-repeat",
              "publish-rejected",
              "publish-calendar-refused",
              "publish-failure",
              "publish-cancelled",
              "calendar-matrix",
              "audit-safe-evidence"
            ]
          },
          "job_id": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "const": "completed"
          },
          "conclusion": {
            "enum": [
              "success",
              "skipped"
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
